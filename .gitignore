# zed settings hold an absolute toolchain path
.zed/
*.swp
__pycache__/

/crates/rise-app/src/config/local.json
.env
.env.*
!.env.example

# fonts are tracked, only download leftovers stay out
/assets/fonts/*.zip
/assets/fonts/*.woff2

# LGPL FFmpeg prefix, built by scripts/build-ffmpeg-lgpl.sh
vendor/ffmpeg/

# rlottie source, fetched by scripts/vendor-rlottie.sh against a pinned hash
vendor/rlottie/

# Noto Sans CJK Regular (Linux fallback face), fetched by scripts/vendor-noto-cjk.sh against a pinned hash
vendor/noto-cjk/

# Noto Sans Thai, Devanagari, Bengali, Tamil, Georgian, Hebrew, Arabic Regular (Linux fallback faces), fetched by scripts/vendor-noto-fallback.sh against pinned hashes
vendor/noto-fallback/
