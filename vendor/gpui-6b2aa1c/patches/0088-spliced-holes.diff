+impl SpliceMap {
+    /// Where a prepaint range of the frame just drawn lies in the spliced one: None when it lies
+    /// inside a hole (drawn fresh) or only partly in one.
+    pub(crate) fn remap_prepaint(&self, range: &Range<PrepaintStateIndex>) -> Option<Range<PrepaintStateIndex>> {
+        let mut start_segment = 0;
+        let mut end_segment = 0;
+        for hole in &self.hole_prepaints {
+            if hole.start.le(&range.start) && range.end.le(&hole.end) {
+                return None;
+            }
+            if hole.end.le(&range.start) {
+                start_segment += 1;
+            } else if hole.start.le(&range.start) {
+                return None;
+            }
+            if !range.end.le(&hole.start) {
+                end_segment += 1;
+            }
+        }
+        let point = |index: &PrepaintStateIndex, segment: usize| {
+            let (old, new_start) = self.prepaint.get(segment)?;
+            PrepaintStateIndex::rebase_within(&(index.clone()..index.clone()), old, new_start)
+                .map(|range| range.start)
+        };
+        Some(point(&range.start, start_segment)?..point(&range.end, end_segment)?)
+    }
