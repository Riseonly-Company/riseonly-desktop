+/// Shapes single-run lines on any thread into the window's retained layouts (Riseonly 0068), so
+/// the frame that first shows them finds the layout instead of shaping it on the main thread.
+#[derive(Clone)]
+pub struct LineLayoutRetainer {
+    platform_text_system: Arc<dyn PlatformTextSystem>,
+    retained: Arc<Mutex<FxHashMap<Arc<CacheKey>, Arc<LineLayout>>>>,
+}
+
+impl LineLayoutRetainer {
+    const MAX_RETAINED_LINES: usize = 16_384;
+
+    /// Shapes `text` as one run of `font_id` at `font_size`, unless it is already retained.
+    pub fn retain(&self, text: SharedString, font_size: Pixels, font_id: FontId) {
+        if text.is_empty() {
+            return;
+        }
+        let runs = [FontRun {
+            len: text.len(),
+            font_id,
+        }];
+        let key = &CacheKeyRef {
+            text: text.as_ref(),
+            font_size,
+            runs: &runs,
+            wrap_width: None,
+            force_width: None,
+        } as &dyn AsCacheKeyRef;
+        if self.retained.lock().contains_key(key) {
+            return;
+        }
+        let layout = Arc::new(self.platform_text_system.layout_line(&text, font_size, &runs));
+        let key = Arc::new(CacheKey {
+            text,
+            font_size,
+            runs: SmallVec::from(&runs[..]),
+            wrap_width: None,
+            force_width: None,
+        });
+        let mut retained = self.retained.lock();
+        if retained.len() >= Self::MAX_RETAINED_LINES {
+            retained.clear();
+        }
+        retained.insert(key, layout);
+    }
+}
