 pub use headless_app_context::*;
 use http_client::{HttpClient, Url};
 use smallvec::SmallVec;
+
+thread_local! {
+    /// Entities the cached view rendering now reads but hears through events only (Riseonly 0075).
+    static EVENT_ONLY_READS: RefCell<SmallVec<[EntityId; 2]>> = RefCell::new(SmallVec::new());
+}
+
+/// Riseonly 0075: the cached view rendering now reads `entity` but hears it through its own
+/// subscription (filtered events), so a notify of `entity` must not make the view or its ancestors
+/// dirty. Call it from the render that reads; the mark lasts for that render, layout and prepaint.
+/// Nested cached views keep tracking the entity as before. Outside a cached view render it is a no-op
+/// for that frame.
+pub fn hear_entity_through_events_only(entity: EntityId) {
+    EVENT_ONLY_READS.with(|reads| {
+        let mut reads = reads.borrow_mut();
+        if !reads.contains(&entity) {
+            reads.push(entity);
+        }
+    });
+}
