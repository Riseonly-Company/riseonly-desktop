+    /// On macOS a PaintSurface carries a CVPixelBuffer for the Metal renderer, not an owned frame.
+    #[cfg(target_os = "macos")]
+    fn prepare_owned_surfaces(&mut self, scene: &Scene) -> Vec<Option<wgpu::BindGroup>> {
+        scene.surfaces.iter().map(|_| None).collect()
+    }
+
+    /// Uploads every owned video frame of the scene whose generation changed and returns one
+    /// bind group per `scene.surfaces` entry (`None`: nothing drawable, the surface is skipped).
+    /// Textures of streams absent from this scene are released.
+    #[cfg(not(target_os = "macos"))]
+    fn prepare_owned_surfaces(&mut self, scene: &Scene) -> Vec<Option<wgpu::BindGroup>> {
+        let max_texture_size = self.max_texture_size;
+        let resources = self.resources_mut();
+        resources
+            .owned_surfaces
+            .retain(|id, _| scene.surfaces.iter().any(|surface| surface.frame.id() == *id));
+
+        let mut bind_groups = Vec::with_capacity(scene.surfaces.len());
+        for surface in &scene.surfaces {
+            let frame = &surface.frame;
+            if frame.width() > max_texture_size || frame.height() > max_texture_size {
+                log::warn!(
+                    "owned surface {}x{} exceeds the maximum texture size {}",
+                    frame.width(),
+                    frame.height(),
+                    max_texture_size
+                );
+                bind_groups.push(None);
+                continue;
+            }
+
+            let device = &resources.device;
+            let textures = resources
+                .owned_surfaces
+                .entry(frame.id())
+                .and_modify(|textures| {
+                    if textures.size != frame.size() {
+                        *textures = Self::create_owned_surface_textures(device, frame.size());
+                    }
+                })
+                .or_insert_with(|| Self::create_owned_surface_textures(device, frame.size()));
+
+            if textures.uploaded_generation != Some(frame.generation()) {
+                let (luma, luma_stride) = frame.luma();
+                let (chroma, chroma_stride) = frame.chroma();
+                Self::upload_plane(&resources.queue, &textures.luma, luma, luma_stride);
+                Self::upload_plane(&resources.queue, &textures.chroma, chroma, chroma_stride);
+                textures.uploaded_generation = Some(frame.generation());
+            }
+
+            let params = SurfaceParams {
+                bounds: surface.bounds.into(),
+                content_mask: surface.content_mask.bounds.into(),
+                ycbcr_to_rgb: frame.ycbcr_to_rgb(),
+            };
+            let params_buffer = device.create_buffer(&wgpu::BufferDescriptor {
+                label: Some("owned_surface_params"),
+                size: std::mem::size_of::<SurfaceParams>() as u64,
+                usage: wgpu::BufferUsages::UNIFORM | wgpu::BufferUsages::COPY_DST,
+                mapped_at_creation: false,
+            });
+            resources
+                .queue
+                .write_buffer(&params_buffer, 0, bytemuck::bytes_of(&params));
+
+            bind_groups.push(Some(device.create_bind_group(&wgpu::BindGroupDescriptor {
+                label: Some("owned_surface_bind_group"),
+                layout: &resources.bind_group_layouts.surfaces,
+                entries: &[
+                    wgpu::BindGroupEntry {
+                        binding: 0,
+                        resource: params_buffer.as_entire_binding(),
+                    },
+                    wgpu::BindGroupEntry {
+                        binding: 1,
+                        resource: wgpu::BindingResource::TextureView(&textures.luma_view),
+                    },
+                    wgpu::BindGroupEntry {
+                        binding: 2,
+                        resource: wgpu::BindingResource::TextureView(&textures.chroma_view),
+                    },
+                    wgpu::BindGroupEntry {
+                        binding: 3,
+                        resource: wgpu::BindingResource::Sampler(&resources.atlas_sampler),
+                    },
+                ],
+            })));
+        }
+        bind_groups
+    }
