+    /// Truncate one line from the end at its shaped glyph positions: every glyph whose right edge
+    /// (the next glyph's origin) fits in `truncate_width` minus the affix stays (patch 0025).
+    pub fn truncate_shaped_line_end<'a>(
+        &mut self,
+        line: SharedString,
+        layout: &LineLayout,
+        truncate_width: Pixels,
+        truncation_affix: &str,
+        runs: &'a [TextRun],
+    ) -> (SharedString, Cow<'a, [TextRun]>) {
+        if layout.width <= truncate_width {
+            return (line, Cow::Borrowed(runs));
+        }
+        let affix_width = truncation_affix
+            .chars()
+            .map(|c| self.width_for_char(c))
+            .fold(px(0.0), |a, x| a + x);
+        let limit = truncate_width - affix_width;
+        let mut glyphs = layout
+            .runs
+            .iter()
+            .flat_map(|run| run.glyphs.iter())
+            .map(|glyph| (glyph.index, glyph.position.x))
+            .peekable();
+        let mut truncate_ix = 0;
+        while let Some((index, _)) = glyphs.next() {
+            let right = glyphs.peek().map_or(layout.width, |(_, x)| *x);
+            if right > limit {
+                truncate_ix = index;
+                break;
+            }
+            truncate_ix = glyphs.peek().map_or(line.len(), |(next, _)| *next);
+        }
+        let truncate_ix = line.floor_char_boundary(truncate_ix.min(line.len()));
+        let result = SharedString::from(format!(
+            "{}{truncation_affix}",
+            line[..truncate_ix].trim_end_matches(|c: char| c.is_whitespace() || c.is_ascii_punctuation())
+        ));
+        let mut runs = runs.to_vec();
+        update_runs_after_truncation(&result, truncation_affix, &mut runs, TruncateFrom::End);
+        (result, Cow::Owned(runs))
+    }
