+// Values of SurfaceParams.pixel_format, the same as SURFACE_FORMAT_* in wgpu_renderer.rs.
+const SURFACE_FORMAT_NV12: u32 = 0u;
+const SURFACE_FORMAT_PREMULTIPLIED: u32 = 1u;
+const SURFACE_FORMAT_PREMULTIPLIED_SWAPPED: u32 = 2u;
+
 @group(1) @binding(0) var<uniform> surface_locals: SurfaceParams;
 @group(1) @binding(1) var t_y: texture_2d<f32>;
 @group(1) @binding(2) var t_cb_cr: texture_2d<f32>;
@@ -1352,6 +1358,18 @@
     // Alpha clip after using the derivatives.
     if (any(input.clip_distances < vec4<f32>(0.0))) {
         return vec4<f32>(0.0);
+    }
+
+    if (surface_locals.pixel_format != SURFACE_FORMAT_NV12) {
+        var color = textureSampleLevel(t_y, s_surface, input.texture_position, 0.0);
+        if (surface_locals.pixel_format == SURFACE_FORMAT_PREMULTIPLIED_SWAPPED) {
+            color = color.bgra;
+        }
+        // The frame is premultiplied; a straight alpha pipeline (blend_color) wants it back.
+        if (globals.premultiplied_alpha == 0u && color.a > 0.0) {
+            color = vec4<f32>(color.rgb / color.a, color.a);
+        }
+        return color;
     }
 
