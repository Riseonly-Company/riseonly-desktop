+
+// Riseonly 0110: the backdrop blur under a quad of BorderStyle::BackdropBlur, a separable gaussian
+// in two passes: across, from the drawable into the scratch texture, then down, from the scratch
+// texture onto the drawable inside the quad's rounded bounds, thinning over its bottom fade. Both
+// textures have the viewport's size, so a pixel samples the same coordinates in either.
+// params: [0] area drawn (x, y, w, h), [1] quad bounds (x, y, w, h), [2] corner radii (top left,
+// top right, bottom right, bottom left), [3] (viewport w, viewport h, direction x, direction y),
+// [4] (sigma, 1 on the pass onto the drawable, fade, unused), [5] the visible quad (quad bounds
+// within its content mask and the viewport, x, y, w, h): every tap stays on whole pixels inside it,
+// so nothing painted beside the quad (a neighbouring panel's video) bleeds into its edge.
+struct BackdropBlurVertexOutput {
+  float4 position [[position]];
+};
+
+vertex BackdropBlurVertexOutput backdrop_blur_vertex(
+    uint unit_vertex_id [[vertex_id]],
+    constant float2 *unit_vertices [[buffer(0)]],
+    constant float4 *params [[buffer(1)]]) {
+  float2 unit_vertex = unit_vertices[unit_vertex_id];
+  float4 area = params[0];
+  float2 position = unit_vertex * area.zw + area.xy;
+  float2 device_position = position / params[3].xy * float2(2., -2.) + float2(-1., 1.);
+  return BackdropBlurVertexOutput{float4(device_position, 0., 1.)};
+}
+
+float backdrop_blur_shape(float2 point, float4 bounds, float4 radii) {
+  float2 half_size = bounds.zw * 0.5;
+  float2 center_to_point = point - (bounds.xy + half_size);
+  float radius = center_to_point.x < 0.0
+      ? (center_to_point.y < 0.0 ? radii.x : radii.w)
+      : (center_to_point.y < 0.0 ? radii.y : radii.z);
+  float2 corner = fabs(center_to_point) - half_size + radius;
+  return length(max(corner, 0.0)) + min(max(corner.x, corner.y), 0.0) - radius;
+}
+
+fragment float4 backdrop_blur_fragment(
+    BackdropBlurVertexOutput input [[stage_in]],
+    constant float4 *params [[buffer(1)]],
+    texture2d<float> source [[texture(0)]]) {
+  constexpr sampler source_sampler(mag_filter::linear, min_filter::linear,
+                                   address::clamp_to_edge);
+  float2 point = input.position.xy;
+  float2 texel = 1.0 / float2(source.get_width(), source.get_height());
+  float2 direction = params[3].zw;
+  float sigma = params[4].x;
+  const int taps = 24;
+  float step = sigma * 3.0 / float(taps);
+  float4 visible = params[5];
+  float2 lowest = ceil(visible.xy) + 0.5;
+  float2 highest = max(lowest, floor(visible.xy + visible.zw) - 0.5);
+  float4 sum = float4(0.0);
+  float weight_sum = 0.0;
+  for (int i = -taps; i <= taps; i++) {
+    float offset = float(i) * step;
+    float weight = exp(-0.5 * offset * offset / (sigma * sigma));
+    float2 tap = clamp(point + direction * offset, lowest, highest);
+    sum += source.sample(source_sampler, tap * texel) * weight;
+    weight_sum += weight;
+  }
+  float4 color = sum / weight_sum;
+  if (params[4].y < 0.5) {
+    return color;
+  }
+  float4 bounds = params[1];
+  float coverage = saturate(0.5 - backdrop_blur_shape(point, bounds, params[2]));
+  float fade = params[4].z;
+  if (fade > 0.0) {
+    float t = saturate((point.y - (bounds.y + bounds.w - fade)) / fade);
+    coverage *= 1.0 - t * t * (3.0 - 2.0 * t);
+  }
+  return float4(color.rgb, coverage);
 }
