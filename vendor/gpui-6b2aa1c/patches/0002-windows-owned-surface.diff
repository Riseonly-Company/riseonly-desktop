+impl OwnedSurfaceTextures {
+    fn new(device: &ID3D11Device, size: Size<DevicePixels>) -> Result<Self> {
+        let width = size.width.0 as u32;
+        let height = size.height.0 as u32;
+        let luma = create_surface_plane_texture(device, width, height, DXGI_FORMAT_R8_UNORM)?;
+        let chroma = create_surface_plane_texture(
+            device,
+            width.div_ceil(2),
+            height.div_ceil(2),
+            DXGI_FORMAT_R8G8_UNORM,
+        )?;
+        let mut views = [None, None];
+        // SAFETY: both textures were just created on `device` with BIND_SHADER_RESOURCE, and
+        // each out pointer is a live slot of `views`.
+        unsafe {
+            device.CreateShaderResourceView(&luma, None, Some(&mut views[0]))?;
+            device.CreateShaderResourceView(&chroma, None, Some(&mut views[1]))?;
+        }
+        Ok(Self {
+            size,
+            uploaded_generation: None,
+            luma,
+            chroma,
+            views,
+        })
+    }
+}
+
+fn create_surface_plane_texture(
+    device: &ID3D11Device,
+    width: u32,
+    height: u32,
+    format: DXGI_FORMAT,
+) -> Result<ID3D11Texture2D> {
+    let desc = D3D11_TEXTURE2D_DESC {
+        Width: width,
+        Height: height,
+        MipLevels: 1,
+        ArraySize: 1,
+        Format: format,
+        SampleDesc: DXGI_SAMPLE_DESC {
+            Count: 1,
+            Quality: 0,
+        },
+        Usage: D3D11_USAGE_DEFAULT,
+        BindFlags: D3D11_BIND_SHADER_RESOURCE.0 as u32,
+        CPUAccessFlags: 0,
+        MiscFlags: 0,
+    };
+    let mut texture = None;
+    // SAFETY: `desc` is a fully initialised descriptor without initial data, and the out pointer
+    // is a live local.
+    unsafe { device.CreateTexture2D(&desc, None, Some(&mut texture)) }?;
+    texture.context("CreateTexture2D returned no owned surface texture")
+}
+
+/// Copies `rows` rows of `row_bytes` bytes, `stride` bytes apart, into the whole of `texture`.
+/// UpdateSubresource reads `stride * rows` bytes, so a plane whose last row is shorter than the
+/// stride is first packed tight.
+/// https://learn.microsoft.com/windows/win32/api/d3d11/nf-d3d11-id3d11devicecontext-updatesubresource
+fn upload_surface_plane(
+    device_context: &ID3D11DeviceContext,
+    texture: &ID3D11Texture2D,
+    plane: &[u8],
+    stride: u32,
+    row_bytes: u32,
+    rows: u32,
+) {
+    let packed: Vec<u8>;
+    let (data, pitch) = if plane.len() >= stride as usize * rows as usize {
+        (plane, stride)
+    } else {
+        packed = plane
+            .chunks(stride as usize)
+            .take(rows as usize)
+            .flat_map(|row| &row[..row_bytes as usize])
+            .copied()
+            .collect();
+        (packed.as_slice(), row_bytes)
+    };
+    // SAFETY: `data` holds `pitch * rows` bytes (checked above or packed tight), which is what
+    // UpdateSubresource reads for the whole subresource of a `row_bytes`-wide, `rows`-high texture.
+    unsafe {
+        device_context.UpdateSubresource(texture, 0, None, data.as_ptr() as _, pitch, 0);
+    }
+}
