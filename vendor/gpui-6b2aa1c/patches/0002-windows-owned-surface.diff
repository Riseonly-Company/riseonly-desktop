+
+/*
+**
+**              Surfaces
+**
+*/
+
+// An owned NV12 video frame: luma in an R8 texture, interleaved CbCr in an R8G8 texture at half
+// resolution, converted with the frame's own matrix. The matrix travels as its four columns so
+// the result does not depend on HLSL matrix packing.
+struct SurfaceSprite {
+    Bounds bounds;
+    Bounds content_mask;
+    float4 ycbcr_to_rgb_0;
+    float4 ycbcr_to_rgb_1;
+    float4 ycbcr_to_rgb_2;
+    float4 ycbcr_to_rgb_3;
+};
+
+struct SurfaceVertexOutput {
+    nointerpolation uint sprite_id: TEXCOORD0;
+    float4 position: SV_Position;
+    float2 texture_position: POSITION;
+    float4 clip_distance: SV_ClipDistance;
+};
+
+struct SurfaceFragmentInput {
+    nointerpolation uint sprite_id: TEXCOORD0;
+    float4 position: SV_Position;
+    float2 texture_position: POSITION;
+};
+
+StructuredBuffer<SurfaceSprite> surface_sprites: register(t1);
+Texture2D<float> t_surface_luma: register(t2);
+Texture2D<float2> t_surface_chroma: register(t3);
+SamplerState s_surface: register(s1);
+
+SurfaceVertexOutput surface_vertex(uint vertex_id: SV_VertexID, uint instance_id: SV_InstanceID) {
+    float2 unit_vertex = float2(float(vertex_id & 1u), 0.5 * float(vertex_id & 2u));
+    uint sprite_id = batch_start_index + instance_id;
+    SurfaceSprite sprite = surface_sprites[sprite_id];
+
+    SurfaceVertexOutput output;
+    output.position = to_device_position(unit_vertex, sprite.bounds);
+    output.texture_position = unit_vertex;
+    output.sprite_id = sprite_id;
+    output.clip_distance = distance_from_clip_rect(unit_vertex, sprite.bounds, sprite.content_mask);
+    return output;
+}
+
+float4 surface_fragment(SurfaceFragmentInput input): SV_Target {
+    SurfaceSprite sprite = surface_sprites[input.sprite_id];
+    float y = t_surface_luma.Sample(s_surface, input.texture_position);
+    float2 cb_cr = t_surface_chroma.Sample(s_surface, input.texture_position);
+    float4 rgb = sprite.ycbcr_to_rgb_0 * y
+        + sprite.ycbcr_to_rgb_1 * cb_cr.x
+        + sprite.ycbcr_to_rgb_2 * cb_cr.y
+        + sprite.ycbcr_to_rgb_3;
+    return float4(saturate(rgb.rgb), 1.0);
+}
