+    /// Uploads every owned video frame of the scene whose generation changed into its stream's
+    /// textures and releases the textures of streams absent from this scene.
+    fn prepare_owned_surfaces(&mut self, scene: &Scene) -> Result<()> {
+        let devices = self.devices.as_ref().context("devices missing")?;
+        self.owned_surfaces
+            .retain(|id, _| scene.surfaces.iter().any(|surface| surface.frame.id() == *id));
+
+        for surface in &scene.surfaces {
+            let frame = &surface.frame;
+            let id = frame.id();
+            if frame.width() > MAX_SURFACE_TEXTURE_DIMENSION
+                || frame.height() > MAX_SURFACE_TEXTURE_DIMENSION
+            {
+                log::warn!(
+                    "owned surface {}x{} exceeds the maximum texture size {}",
+                    frame.width(),
+                    frame.height(),
+                    MAX_SURFACE_TEXTURE_DIMENSION
+                );
+                self.owned_surfaces.remove(&id);
+                continue;
+            }
+
+            if self
+                .owned_surfaces
+                .get(&id)
+                .is_some_and(|textures| textures.size != frame.size())
+            {
+                self.owned_surfaces.remove(&id);
+            }
+            if !self.owned_surfaces.contains_key(&id) {
+                match OwnedSurfaceTextures::new(&devices.device, frame.size()) {
+                    Ok(textures) => {
+                        self.owned_surfaces.insert(id, textures);
+                    }
+                    Err(error) => {
+                        log::error!("creating owned surface textures: {error:#}");
+                        continue;
+                    }
