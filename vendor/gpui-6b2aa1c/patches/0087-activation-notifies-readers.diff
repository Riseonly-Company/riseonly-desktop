@@ -1991,14 +1994,20 @@
                             .retain(&(), |callback| callback(window, cx));
 
                         window.bounds_changed(cx);
-                        // Riseonly 0066: only a window that becomes active is drawn whole again
-                        // (animated images ask for frames only while the window is active, so their
-                        // cached views must paint once more). Losing activation changes nothing on
