+
+impl SharedSurfaceTexture {
+    fn open(
+        device: &ID3D11Device,
+        stream: u64,
+        shared: SharedSurfaceHandle,
+        epoch: u64,
+    ) -> Result<Self> {
+        let device1: ID3D11Device1 = device.cast()?;
+        // SAFETY: the frame carrying `shared` keeps the NT handle open while it lives, and it
+        // lives through this prepare; the opened resource holds its own reference afterwards.
+        // https://learn.microsoft.com/windows/win32/api/d3d11_1/nf-d3d11_1-id3d11device1-opensharedresource1
+        let texture: ID3D11Texture2D =
+            unsafe { device1.OpenSharedResource1(HANDLE(shared.handle as *mut _)) }?;
+        let mut desc = D3D11_TEXTURE2D_DESC::default();
+        // SAFETY: `texture` is live and `desc` a writable local.
+        unsafe { texture.GetDesc(&mut desc) };
+        anyhow::ensure!(
+            desc.Format == DXGI_FORMAT_NV12,
+            "shared surface format {:?} is not NV12",
+            desc.Format
+        );
+        let mutex: IDXGIKeyedMutex = texture.cast()?;
+        let mut views = [None, None];
+        for (view, format) in views
+            .iter_mut()
+            .zip([DXGI_FORMAT_R8_UNORM, DXGI_FORMAT_R8G8_UNORM])
+        {
+            // R8 views the luma plane of an NV12 texture and R8G8 its half-size chroma plane.
+            // https://learn.microsoft.com/windows/win32/medfound/recommended-8-bit-yuv-formats-for-video-rendering#nv12
+            let view_desc = D3D11_SHADER_RESOURCE_VIEW_DESC {
+                Format: format,
+                ViewDimension: D3D_SRV_DIMENSION_TEXTURE2D,
+                Anonymous: D3D11_SHADER_RESOURCE_VIEW_DESC_0 {
+                    Texture2D: D3D11_TEX2D_SRV {
+                        MostDetailedMip: 0,
+                        MipLevels: 1,
+                    },
+                },
+            };
+            // SAFETY: `view_desc` is fully initialised for a 2D texture of one mip level, and the
+            // out pointer is a live slot of `views`.
+            unsafe { device.CreateShaderResourceView(&texture, Some(&view_desc), Some(view)) }?;
+        }
+        Ok(Self {
+            stream,
+            last_seen: epoch,
+            mutex,
+            views,
         })
     }
+}
+
+/// Takes `key` of a keyed mutex. AcquireSync reports WAIT_TIMEOUT and WAIT_ABANDONED as success
+/// HRESULTs, which the wrapper's Result hides, so only S_OK counts as held.
+/// https://learn.microsoft.com/windows/win32/api/dxgi/nf-dxgi-idxgikeyedmutex-acquiresync
+fn acquire_keyed_mutex(mutex: &IDXGIKeyedMutex, key: u64, milliseconds: u32) -> bool {
+    // SAFETY: `mutex` is a live interface and AcquireSync takes no pointers.
+    let status = unsafe {
+        (Interface::vtable(mutex).AcquireSync)(Interface::as_raw(mutex), key, milliseconds)
+    };
+    status.0 == 0
 }
 
