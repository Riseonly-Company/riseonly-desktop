+    /// Shapes `text` in `font` at `font_size` and rasterizes each distinct emoji glyph of it with
+    /// the params Window::paint_emoji uses at `scale_factor` (Riseonly 0060). Meant for a
+    /// background thread: the tiles go to the atlas later through Window::prewarm_emoji_tiles.
+    pub fn rasterize_emoji_text(
+        &self,
+        text: &str,
+        font: &Font,
+        font_size: Pixels,
+        scale_factor: f32,
+    ) -> Vec<(RenderGlyphParams, Size<DevicePixels>, Vec<u8>)> {
+        if text.is_empty() {
+            return Vec::new();
+        }
+        let font_id = self.resolve_font(font);
+        let layout = self.platform_text_system.layout_line(
+            text,
+            font_size,
+            &[FontRun {
+                len: text.len(),
+                font_id,
+            }],
+        );
+        let mut seen = collections::FxHashSet::default();
+        let mut tiles = Vec::new();
+        for run in &layout.runs {
+            for glyph in run.glyphs.iter().filter(|glyph| glyph.is_emoji) {
+                let params = RenderGlyphParams {
+                    font_id: run.font_id,
+                    glyph_id: glyph.id,
+                    font_size,
+                    subpixel_variant: Default::default(),
+                    scale_factor,
+                    is_emoji: true,
+                    subpixel_rendering: false,
+                    dilation: 0,
+                };
+                if !seen.insert(params.clone()) {
+                    continue;
+                }
+                let Ok(bounds) = self.raster_bounds(&params) else {
+                    continue;
+                };
+                if crate::geometry::IsZero::is_zero(&bounds) {
+                    continue;
+                }
+                if let Ok((size, bytes)) = self.platform_text_system.rasterize_glyph(&params, bounds) {
+                    tiles.push((params, size, bytes));
+                }
+            }
+        }
+        tiles
+    }
