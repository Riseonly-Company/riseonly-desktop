+
+// An owned BGRA frame with premultiplied alpha (a WebM sticker with its alpha stream joined in):
+// one B8G8R8A8 texture, which the sampler returns as RGBA, drawn with the premultiplied blend
+// state (ONE, INV_SRC_ALPHA). The sprite and the vertex stage are the NV12 surface's; the
+// conversion matrix is unused.
+Texture2D<float4> t_surface_bgra: register(t2);
+
+SurfaceVertexOutput bgra_surface_vertex(uint vertex_id: SV_VertexID, uint instance_id: SV_InstanceID) {
+    return surface_vertex(vertex_id, instance_id);
+}
+
+float4 bgra_surface_fragment(SurfaceFragmentInput input): SV_Target {
+    return t_surface_bgra.Sample(s_surface, input.texture_position);
+}
