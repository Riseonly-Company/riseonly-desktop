+const VIRTUAL_DROP_FOLDER: &str = "riseonly-drop";
+const VIRTUAL_DROP_MAX_AGE: Duration = Duration::from_secs(24 * 60 * 60);
+const VIRTUAL_DROP_CHUNK: usize = 64 * 1024;
+
+/// Riseonly 0130: virtual files a drag source offers and the temporary paths their bytes go to.
+struct VirtualDrop {
+    contents_format: u16,
+    items: Vec<(i32, PathBuf)>,
+}
+
+impl VirtualDrop {
+    /// Reads only the descriptors: names and indexes, no file contents and no disk writes.
+    unsafe fn offered(data: &IDataObject) -> Option<Self> {
+        let descriptor_format = unsafe {
+            windows::Win32::System::DataExchange::RegisterClipboardFormatW(windows::core::w!("FileGroupDescriptorW"))
+        };
+        let contents_format = unsafe {
+            windows::Win32::System::DataExchange::RegisterClipboardFormatW(windows::core::w!("FileContents"))
+        };
+        if descriptor_format == 0 || contents_format == 0 {
+            return None;
+        }
+        let descriptor_config = FORMATETC {
+            cfFormat: descriptor_format as u16,
+            ptd: std::ptr::null_mut(),
+            dwAspect: DVASPECT_CONTENT.0,
+            lindex: -1,
+            tymed: TYMED_HGLOBAL.0 as _,
+        };
+        if unsafe { data.QueryGetData(&descriptor_config) } != S_OK {
+            return None;
+        }
+        let mut medium = (unsafe { data.GetData(&descriptor_config) }).log_err()?;
+        let names = unsafe { virtual_file_names(medium.u.hGlobal) };
+        unsafe { ReleaseStgMedium(&mut medium) };
+        if names.is_empty() {
+            return None;
+        }
+        let stamp = std::time::SystemTime::now()
+            .duration_since(std::time::UNIX_EPOCH)
+            .map_or(0, |elapsed| elapsed.as_nanos());
+        let folder = std::env::temp_dir().join(VIRTUAL_DROP_FOLDER).join(stamp.to_string());
+        let items = names.into_iter().map(|(index, name)| (index as i32, folder.join(name))).collect();
+        Some(Self { contents_format: contents_format as u16, items })
+    }
+
+    /// Streams each item's contents into its path; an item that cannot be read leaves no file.
+    unsafe fn write(&self, data: &IDataObject) {
+        remove_stale_virtual_drops();
+        for (index, path) in &self.items {
+            let Some(folder) = path.parent() else {
+                continue;
+            };
+            if std::fs::create_dir_all(folder).log_err().is_none() {
+                return;
+            }
+            let contents_config = FORMATETC {
+                cfFormat: self.contents_format,
+                ptd: std::ptr::null_mut(),
+                dwAspect: DVASPECT_CONTENT.0,
+                lindex: *index,
+                tymed: (TYMED_HGLOBAL.0 | TYMED_ISTREAM.0) as _,
+            };
+            let Ok(mut medium) = (unsafe { data.GetData(&contents_config) }) else {
+                continue;
+            };
+            let written = std::fs::File::create(path)
+                .map_err(anyhow::Error::from)
+                .and_then(|mut file| unsafe { copy_stgmedium(&medium, &mut file) });
+            unsafe { ReleaseStgMedium(&mut medium) };
+            if written.log_err().is_none() {
+                std::fs::remove_file(path).ok();
+            }
+        }
+    }
+}
+
+/// Riseonly 0130: drops older than a day are gone from %TEMP%, newer ones may still be in use.
+fn remove_stale_virtual_drops() {
+    let root = std::env::temp_dir().join(VIRTUAL_DROP_FOLDER);
+    let Ok(entries) = std::fs::read_dir(&root) else {
+        return;
+    };
+    for entry in entries.flatten() {
+        let stale = entry
+            .metadata()
+            .and_then(|metadata| metadata.modified())
+            .ok()
+            .and_then(|modified| modified.elapsed().ok())
+            .is_some_and(|age| age > VIRTUAL_DROP_MAX_AGE);
+        if stale {
+            std::fs::remove_dir_all(entry.path()).ok();
+        }
+    }
+}
+
+/// Index and plain file name of every file entry in a FILEGROUPDESCRIPTORW.
+unsafe fn virtual_file_names(global: HGLOBAL) -> Vec<(usize, String)> {
+    let mut names = Vec::new();
+    if global.is_invalid() {
+        return names;
+    }
+    let size = unsafe { windows::Win32::System::Memory::GlobalSize(global) };
+    let base = unsafe { windows::Win32::System::Memory::GlobalLock(global) } as *const u8;
+    if base.is_null() || size < std::mem::size_of::<u32>() {
+        if !base.is_null() {
+            unsafe { windows::Win32::System::Memory::GlobalUnlock(global) }.ok();
+        }
+        return names;
+    }
+    let count = unsafe { (base as *const u32).read_unaligned() } as usize;
+    let entry = std::mem::size_of::<FILEDESCRIPTORW>();
+    let available = (size - std::mem::size_of::<u32>()) / entry;
+    let first = unsafe { base.add(std::mem::size_of::<u32>()) } as *const FILEDESCRIPTORW;
+    for index in 0..count.min(available) {
+        let descriptor = unsafe { first.add(index).read_unaligned() };
+        if descriptor.dwFileAttributes & windows::Win32::Storage::FileSystem::FILE_ATTRIBUTE_DIRECTORY.0 != 0 {
+            continue;
+        }
+        let raw = descriptor.cFileName;
+        let length = raw.iter().position(|unit| *unit == 0).unwrap_or(raw.len());
+        let full = String::from_utf16_lossy(&raw[..length]);
+        let name = full.rsplit(['\\', '/']).next().unwrap_or_default().trim().to_owned();
+        let name: String = name.chars().filter(|c| !matches!(c, ':' | '*' | '?' | '"' | '<' | '>' | '|')).collect();
+        if !name.is_empty() && name != "." && name != ".." {
+            names.push((index, name));
+        }
+    }
+    unsafe { windows::Win32::System::Memory::GlobalUnlock(global) }.ok();
+    names
+}
+
+/// Copies a FileContents medium (an HGLOBAL block or a stream) into a file chunk by chunk.
+unsafe fn copy_stgmedium(medium: &STGMEDIUM, file: &mut std::fs::File) -> Result<()> {
+    use std::io::Write as _;
+    if medium.tymed == TYMED_HGLOBAL.0 as u32 {
+        let global = unsafe { medium.u.hGlobal };
+        anyhow::ensure!(!global.is_invalid(), "FileContents HGLOBAL is invalid");
+        let size = unsafe { windows::Win32::System::Memory::GlobalSize(global) };
+        let base = unsafe { windows::Win32::System::Memory::GlobalLock(global) } as *const u8;
+        anyhow::ensure!(!base.is_null(), "GlobalLock returned null");
+        let written = file.write_all(unsafe { std::slice::from_raw_parts(base, size) });
+        unsafe { windows::Win32::System::Memory::GlobalUnlock(global) }.ok();
+        return Ok(written?);
+    }
+    anyhow::ensure!(medium.tymed == TYMED_ISTREAM.0 as u32, "FileContents medium {} is not supported", medium.tymed);
+    let stream = unsafe { (*medium.u.pstm).as_ref() }.context("FileContents stream is missing")?;
+    let mut chunk = vec![0u8; VIRTUAL_DROP_CHUNK];
+    loop {
+        let mut read = 0u32;
+        unsafe { stream.Read(chunk.as_mut_ptr().cast(), chunk.len() as u32, Some(&mut read)) }.ok()?;
+        if read == 0 {
+            return Ok(());
+        }
+        file.write_all(&chunk[..read as usize])?;
+    }
+}
