{
  "version": 1,
  "about": "Which crate holds each file of the logical tree (02 section 3). Paths are logical: relative to the app src root, snake_case, mirroring riseonly-ios. A kit crate has a logical prefix: crates/rise-ui/src/<rel> is the logical file core/ui/<rel>, and the app re-exports it there, so crate::core::ui::... is one path. A crate with no prefix other than the default is standalone (its own namespace, not mounted). A '*' matches exactly one path segment. 'files' wins over 'rules', the first matching rule wins, then the longest crate prefix, then the default crate. gen-mod-tree.py reads this file and writes every mod.rs and the mod list of each lib.rs (its docstring describes reexport, lib, cfg and vis).",
  "default": "riseonly",
  "crates": {
    "riseonly": {
      "dir": "app",
      "src": "app/src",
      "ident": "riseonly",
      "below": null,
      "forbid": []
    },
    "rise-ui": {
      "dir": "crates/rise-ui",
      "src": "crates/rise-ui/src",
      "ident": "rise_ui",
      "prefix": "core/ui",
      "below": null,
      "forbid": [],
      "reexport": "all",
      "lib": "block"
    },
    "rise-widgets": {
